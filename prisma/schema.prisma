// Notedo schema
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  authSessions Session[]
  subjects   Subject[]
  sessions   StudySession[]
  goals      Goal[]
  reviews    Review[]
  flashcards Flashcard[]
  events     CalendarEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subject {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#a78bfa")
  icon      String?
  priority  Priority @default(MEDIUM)
  progress  Int      @default(0)
  tags      String[]
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics    Topic[]
  sessions  StudySession[]
  reviews   Review[]
  events    CalendarEvent[]
  summaries Summary[]

  @@index([userId])
}

model Topic {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Topic?   @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Topic[]  @relation("TopicHierarchy")
  title     String
  notes     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions StudySession[]

  @@index([subjectId])
  @@index([parentId])
}

model StudySession {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId       String?
  subject         Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topicId         String?
  topic           Topic?      @relation(fields: [topicId], references: [id], onDelete: SetNull)
  mode            TimerMode   @default(POMODORO)
  startedAt       DateTime    @default(now())
  endedAt         DateTime?
  durationSeconds Int         @default(0)
  notes           String?
  focusScore      Int?
  createdAt       DateTime    @default(now())

  @@index([userId, startedAt])
  @@index([subjectId])
}

model Goal {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      GoalType
  metric    GoalMetric
  target    Float
  label     String
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model Review {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title       String
  scheduledAt DateTime
  completedAt DateTime?
  interval    Int        @default(1)
  ease        Float      @default(2.5)
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime   @default(now())

  @@index([userId, scheduledAt])
}

model Flashcard {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  front     String
  back      String
  deck      String?
  ease      Float    @default(2.5)
  interval  Int      @default(1)
  nextReview DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, nextReview])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TimerMode {
  POMODORO
  FREE
  REVERSE
  CUSTOM
}

enum GoalType {
  DAILY
  WEEKLY
  MONTHLY
}

enum GoalMetric {
  HOURS
  TASKS
  SESSIONS
  REVIEWS
}

enum ReviewStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum EventType {
  EXAM
  TASK
  CLASS
  CUSTOM
}

model CalendarEvent {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  type      EventType @default(CUSTOM)
  title     String
  notes     String?
  date      DateTime
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, date])
  @@index([subjectId])
}

model Summary {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title     String
  content   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
}
