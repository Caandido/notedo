# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/notedo?schema=public"

# Auth.js v5 (NextAuth)
# Gere AUTH_SECRET com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# GitHub OAuth: crie um App em https://github.com/settings/applications/new
# Callback URL: <BASE_URL>/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# IA (opcional — quando ativar o módulo de IA)
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
